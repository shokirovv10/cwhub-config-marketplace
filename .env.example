SECRET_KEY=change-this-in-production
DATABASE_URL=sqlite:///cwhub.db
UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH=33554432
ADMIN_EMAIL=admin@cwhub.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
FLASK_DEBUG=1

# Optional production object storage
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

SUPPORT_TELEGRAM=https://t.me/shokirjonshokirov
ADMIN_BOOTSTRAP=true

# Render production: Render PostgreSQL connection string is injected automatically.
# For local PostgreSQL you can use: postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
SESSION_COOKIE_SECURE=0
REMEMBER_COOKIE_SECURE=0

# CwHUB V20
COMMISSION_RATE=10
MIN_WITHDRAWAL=50000
MAINTENANCE_MODE=false
TEST_MODE=false
MAX_UPLOAD_MB=32
MAX_IMAGE_MB=8
MAX_DOCUMENT_MB=12
SELLER_AUTO_APPROVAL=false
CONFIG_AUTO_APPROVAL=false
SITE_URL=https://cwhub-cfg1.onrender.com
